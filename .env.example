# OS26 Factory environment — copy to .env and fill in.

# Bastion ingest (for live telemetry → bastion.pistonsolutions.ai)
# Use the same bk_* in ~/.bastion/credentials.json or mint a fresh one
# from https://bastion.pistonsolutions.ai (sign in → settings → API keys).
BASTION_API_KEY=bk_live_...

# Override the runner URL if needed (default = https://bastion-runner.pistonsolutions.ai)
# BASTION_SERVER_URL=https://bastion-runner.pistonsolutions.ai

# Telnyx Messaging — for SMS notify after a successful run
TELNYX_API_KEY=KEY...
TELNYX_FROM_NUMBER=+1XXXXXXXXXX
# Optional: a specific messaging profile id
# TELNYX_MESSAGING_PROFILE_ID=...

# Who gets the SMS
NOTIFY_TO_NUMBER=+15145038061

# Vercel — for non-interactive deploys. If unset, you must `vercel login` interactively first.
# Generate at https://vercel.com/account/tokens
# VERCEL_TOKEN=...
